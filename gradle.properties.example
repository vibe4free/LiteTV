# Release Signing Configuration (本地配置模板)
#
# 复制本文件为 gradle.properties，然后填入实际的签名信息。
# gradle.properties 已被 .gitignore 忽略，请勿提交；本模板中不得写入真实口令。
#
# 创建签名库：
# keytool -genkey -v \
#   -keystore keystore/litetv.keystore \
#   -keyalg RSA -keysize 2048 -validity 10000 \
#   -alias your-alias \
#   -storepass "$STORE_PASSWORD" \
#   -keypass "$KEY_PASSWORD" \
#   -dname "CN=YourName, OU=Unit, O=Organization, L=Location, ST=State, C=Country"

# 签名密钥库路径。相对路径按项目根目录解析（默认 keystore/litetv.keystore），也可用绝对路径。
RELEASE_KEYSTORE_PATH=keystore/litetv.keystore

# 签名密钥库密码（填入真实值，切勿提交）
RELEASE_KEYSTORE_PASSWORD=CHANGE_ME

# 签名密钥别名
RELEASE_KEY_ALIAS=CHANGE_ME

# 签名密钥密码（填入真实值，切勿提交）
RELEASE_KEY_PASSWORD=CHANGE_ME

# 应用版本号（每次发布递增）
APP_VERSION_CODE=1

# 应用版本名
APP_VERSION_NAME=1.0.0

# 其他 Gradle 配置
org.gradle.jvmargs=-Xmx2048m
org.gradle.parallel=true
org.gradle.caching=true
