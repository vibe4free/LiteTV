    <!--
        The settings panel follows the Apple TV look: a black ground, one accent colour, and
        greys for everything that is not the accent. The panel itself is nearly opaque so the
        picture beside it stays the brighter thing on the screen.
    -->
    <!--
        Fully opaque on purpose. A translucent panel leaves the window "transparent" there, and
        the television then punches the video layer through it: the panel is drawn but never
        reaches the screen. The picture stays visible on the left third, which is the point.
    -->
    <color name="apple_panel_bg">#FF000000</color>
    <color name="apple_row_focus">#26FF6B35</color>
    <color name="apple_border">#2A2A2E</color>
    <color name="apple_pill_pressed">#1AFFFFFF</color>
