<?xml version="1.0" encoding="utf-8"?>
<!--
    The highlight behind a focused row (a radio button, a check box). Apple TV marks the focused
    row with a soft accent tint rather than a hard border, which reads calmer on a large screen.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/apple_row_focus" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
