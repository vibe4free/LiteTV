<?xml version="1.0" encoding="utf-8"?>
<!--
    A pill shaped button, the way Apple TV draws its controls. The focused state is a filled
    accent pill: on a television the focus is the only pointer the viewer has, so it has to be
    impossible to miss.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorAccent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/apple_pill_pressed" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/apple_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/apple_border" />
        </shape>
    </item>
</selector>
