<?xml version="1.0" encoding="utf-8"?>
<!--
    A replay badge: an anticlockwise arrow, drawn as a vector.

    It replaces a "◉" character that shipped in the text and rendered as an empty box on
    televisions whose system font has no glyph for it. A vector is a few hundred bytes, scales to
    any density without a bitmap, and cannot go missing from a font.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FF9966">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,5V1L7,6l5,5V7c3.31,0 6,2.69 6,6s-2.69,6 -6,6 -6,-2.69 -6,-6H4c0,4.42 3.58,8 8,8s8,-3.58 8,-8 -3.58,-8 -8,-8z" />
</vector>
