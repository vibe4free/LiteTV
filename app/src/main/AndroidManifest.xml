<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.cabletv.player">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
        Reading a playlist the user copied onto the device. Android 10 and older need the legacy
        storage permission; on Android 11+ the same job needs all-files access, because scoped
        storage hides /sdcard/LiteTV and USB volumes from a normal app. Both are only ever used
        to scan the advertised drop folder (issue #7), and all-files access is requested from the
        settings screen rather than assumed. This app is distributed as a sideloaded APK, not
        through Play, so the all-files permission is allowed here.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!--
        Sideloaded apps cannot rely on a store to deliver updates, so LiteTV installs its own
        releases. Requesting the install permission is what lets the system package installer be
        invoked for the APK we downloaded; without it the install intent is silently dropped on
        Android 8+. Play restricts this permission to apps whose core purpose is installing
        packages, but that policy only applies to Play-distributed apps and LiteTV ships APKs on
        GitHub Releases. On Android 8+ the permission is also gated per app by the system
        ("install unknown apps"), which the updater checks before starting a download.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:requiredForAllUsers="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Shares the downloaded APK with the system installer. The installer is a different app, so
            a file:// URI would be rejected on Android 7+ (FileUriExposedException) and the download
            would be unreachable; a content:// URI with a one-shot read grant is the supported path.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
